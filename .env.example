# ---------------------------------------------------------------------------
#  The Thomian Store — environment
#  Copy to .env.local for local development. On Vercel, add the same keys under
#  Project → Settings → Environment Variables (and "Pull" them with `vercel env pull`).
# ---------------------------------------------------------------------------

# Postgres connection string. Any Postgres 14+ works: Neon, Supabase,
# Vercel Postgres, RDS, or a local server.
DATABASE_URL="postgresql://user:password@host:5432/thomian_store?sslmode=require"

# Public URL of the deployment — used for canonical links, the sitemap and
# Open Graph metadata. No trailing slash.
NEXT_PUBLIC_SITE_URL="https://the-thomian-store.vercel.app"

# ---------------------------------------------------------------------------
#  Database backend
# ---------------------------------------------------------------------------
# Leave DATABASE_URL empty to use the embedded PGlite database (Postgres in
# WASM, data in .pglite/) — this is what makes the store work with no server,
# e.g. in StackBlitz. Set DATABASE_URL to use a real PostgreSQL instead.
#
# STORE_BACKEND=pg       force the server database
# STORE_BACKEND=pglite   force the embedded database
# STORE_BACKEND=none     read-only seed data (no writes at all)

# ---------------------------------------------------------------------------
#  Event tickets — QR signing and the admin panel
# ---------------------------------------------------------------------------
# Signs every ticket QR. Without it the app falls back to a development key and
# warns; on a live site a missing secret means anyone could forge a ticket.
#   openssl rand -hex 32
TICKET_SECRET=""

# The password for /admin and /gate. Leave it empty and the admin panel stays
# switched off entirely.
ADMIN_PASSWORD=""

# Optional: signs the admin cookie. Defaults to TICKET_SECRET, which is fine for
# a single school store.
ADMIN_SECRET=""

# Absolute URL used inside the QR codes, so a phone camera opens the right host.
# Must match the deployed domain, no trailing slash.
# NEXT_PUBLIC_SITE_URL="https://the-thomian-store.vercel.app"

# ---------------------------------------------------------------------------
#  Ticket email — use Resend, or any SMTP server, or neither
# ---------------------------------------------------------------------------
# Resend is used when its key is present.
# RESEND_API_KEY="re_..."

# Otherwise SMTP (Gmail, the school's mail server, …) is used.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="0"          # "1" for port 465
# SMTP_USER=""
# SMTP_PASS=""

# The From: line on the ticket email. The domain must be verified with whichever
# provider you use.
MAIL_FROM="The Thomian Store <tickets@stcmthomian.lk>"
