{
  "name": "thomian-store",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0 --webpack",
    "dev:turbo": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build --webpack",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file=.env.local scripts/db-migrate.mjs",
    "db:seed": "node --env-file=.env.local scripts/db-seed.mjs",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "db:reset:embedded": "node scripts/pglite-reset.mjs",
    "build:turbo": "next build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "clsx": "2.1.1",
    "lucide-react": "^1.78.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/oxide-wasm32-wasi": "^4.3.5",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "22.19.17",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "5.9.3"
  }
}
